{
  "name": "Majdi Corail - Pollo AI Video Generator",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Lancer manuellement",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "prompt",
              "name": "prompt",
              "value": "Cinematic close-up of a stunning red coral necklace on dark velvet, warm golden hour lighting from the side, shallow depth of field, each coral bead glistening with natural red tones, Mediterranean luxury feel, slow camera movement revealing the details, 9:16 vertical format, photorealistic, no text, no watermark",
              "type": "string"
            },
            {
              "id": "legende",
              "name": "legende",
              "value": "Ce collier a passe des dizaines d'annees au fond de la Mediterranee avant d'arriver jusqu'a toi.\n\nChaque perle a ete polie a la main. Le rouge, tu ne peux pas le reproduire.\n\n#corailrouge #corail #bijoux #majdicorail #handmade #artisanat #mediterranee #tabarka #tunisie #fyp",
              "type": "string"
            },
            {
              "id": "resolution",
              "name": "resolution",
              "value": "720p",
              "type": "string"
            },
            {
              "id": "duree",
              "name": "duree",
              "value": "5",
              "type": "number"
            }
          ]
        }
      },
      "id": "set-params",
      "name": "Parametres video",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pollo.ai/api/platform/generation/pollo/pollo-v1-6",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-api-key",
              "value": "={{ $env.POLLO_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"input\": {\n    \"prompt\": \"{{ $json.prompt }}\",\n    \"resolution\": \"{{ $json.resolution }}\",\n    \"mode\": \"basic\",\n    \"length\": {{ $json.duree }}\n  }\n}",
        "options": {}
      },
      "id": "generate-video",
      "name": "Pollo AI - Generer video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-1",
      "name": "Attendre 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://pollo.ai/api/platform/generation/task/{{ $node['Pollo AI - Generer video'].json.data.task_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.POLLO_API_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "id": "check-status",
      "name": "Verifier statut",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-1",
              "leftValue": "={{ $json.data.status }}",
              "rightValue": "succeed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-done",
      "name": "Video prete ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-2",
      "name": "Re-attendre 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1320, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node['Verifier statut'].json.data.output.video_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-video",
      "name": "Telecharger la video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -200]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "=reel-majdi-corail-{{ $now.format('yyyy-MM-dd-HHmm') }}.mp4",
        "folderId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "options": {}
      },
      "id": "google-drive",
      "name": "Sauver sur Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1540, -200]
    }
  ],
  "connections": {
    "Lancer manuellement": {
      "main": [
        [
          {
            "node": "Parametres video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parametres video": {
      "main": [
        [
          {
            "node": "Pollo AI - Generer video",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pollo AI - Generer video": {
      "main": [
        [
          {
            "node": "Attendre 30s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Attendre 30s": {
      "main": [
        [
          {
            "node": "Verifier statut",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verifier statut": {
      "main": [
        [
          {
            "node": "Video prete ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Video prete ?": {
      "main": [
        [
          {
            "node": "Telecharger la video",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Re-attendre 30s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Re-attendre 30s": {
      "main": [
        [
          {
            "node": "Verifier statut",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telecharger la video": {
      "main": [
        [
          {
            "node": "Sauver sur Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
