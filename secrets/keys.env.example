# Modèle de clés d'API - copier ce fichier en "keys.env" et remplir les valeurs

# Shopify
SHOPIFY_STORE_URL=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ACCESS_TOKEN=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# Instagram / Meta
INSTAGRAM_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# OpenAI (si utilisé pour Maya ou génération d'images)
OPENAI_API_KEY=

# ElevenLabs (voix IA pour Maya)
ELEVENLABS_API_KEY=

# Autres
